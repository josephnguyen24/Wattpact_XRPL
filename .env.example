# Copier en .env (jamais commité). Généré automatiquement par : npm run setup:wallets
# Comptes de TEST uniquement. Aucune seed Mainnet, jamais.

# Serveurs Testnet, séparés par des virgules (le premier qui répond est utilisé)
XRPL_SERVERS=wss://s.altnet.rippletest.net:51233,wss://testnet.xrpl-labs.com,wss://testnet.honeycluster.io

# Seeds des 5 comptes de test
SEED_OPERATOR=
SEED_VERIFIER=
SEED_FOYER1=
SEED_FOYER2=
SEED_FOYER3=

# Secret du vérificateur : sert à dériver les valeurs secrètes (Fulfillment) des escrows
VERIFIER_SECRET=

# Durée avant CancelAfter, en secondes (court pour la démo)
CANCEL_AFTER_SECONDS=180
