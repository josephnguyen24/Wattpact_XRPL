{
  "name": "wattpact",
  "version": "0.1.0",
  "description": "WattPact : marché de l'effacement de consommation sur le XRP Ledger (Testnet)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "check":"node src/scripts/check-testnet.js",
